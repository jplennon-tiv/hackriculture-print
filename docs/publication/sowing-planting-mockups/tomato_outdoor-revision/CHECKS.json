        ],
        "tableCells": [
          {
            "text": "Blight — Brown dying leaves; dark fruit rot.",
            "box": [
              48.1875,
              462.3046875,
              274.95703125,
              475.06640625
            ]
          },
          {
            "text": "Remove infected plants; keep foliage dry where practical.",
            "box": [
              274.95703125,
              462.3046875,
              501.7265625,
              475.06640625
            ]
          },
          {
            "text": "Blossom end rot — Dark leathery patch at fruit base.",
            "box": [
              48.1875,
              475.06640625,
              274.95703125,
              488.203125
            ]
          },
          {
            "text": "Keep roots evenly moist, especially as fruit swells.",
            "box": [
              274.95703125,
              475.06640625,
              501.7265625,
              488.203125
            ]
          },
          {
            "text": "Slugs — Low fruit is chewed or hollowed.",
            "box": [
              48.1875,
              488.203125,
              274.95703125,
              501.33984375
            ]
          },
          {
            "text": "Raise low fruit off the soil. Pick off slugs near plants.",
            "box": [
              274.95703125,
              488.203125,
              501.7265625,
              501.33984375
            ]
          },
          {
            "text": "Split fruit — Fruit cracks after rain or uneven watering.",
            "box": [
              48.1875,
              501.33984375,
              274.95703125,
              514.4765625
            ]
          },
          {
            "text": "Keep root moisture steady and mulch.",
            "box": [
              274.95703125,
              501.33984375,
              501.7265625,
              514.4765625
            ]
          },
          {
            "text": "Aphids — Colonies on young growth.",
            "box": [
              48.1875,
              514.4765625,
              274.95703125,
              527.61328125
            ]
          },
          {
            "text": "Squash damaging colonies. Encourage predators.",
            "box": [
              274.95703125,
              514.4765625,
              501.7265625,
              527.61328125
            ]
          },
          {
            "text": "Grey mould (Botrytis) — Grey fuzz on damaged stems or fruit.",
            "box": [
              48.1875,
              527.61328125,
              274.95703125,
              550.88671875
            ]
          },
          {
            "text": "Remove infected tissue and dead material; ventilate.",
            "box": [
              274.95703125,
              527.61328125,
              501.7265625,
              550.88671875
            ]
          },
          {
            "text": "Virus — Leaves mottled and distorted; plants stunted.",
            "box": [
              48.1875,
              550.88671875,
              274.95703125,
              564.0234375
            ]
          },
          {
            "text": "Remove affected plants; clean hands/tools; monitor aphids.",
            "box": [
              274.95703125,
              550.88671875,
              501.7265625,
              564.0234375
            ]
          },
          {
            "text": "Blossom drop — Flowers wither and fall without setting.",
            "box": [
              48.1875,
              564.0234375,
              274.95703125,
              577.16015625
            ]
          },
          {
            "text": "Water steadily; ventilate in heat; gently tap trusses.",
            "box": [
              274.95703125,
              564.0234375,
              501.7265625,
              577.16015625
            ]
          },
          {
            "text": "Cutworms — Young stems are severed near soil level.",
            "box": [
              48.1875,
              577.16015625,
              274.95703125,
              590.296875
            ]
          },
          {
            "text": "Protect seedlings with collars; inspect nearby soil.",
            "box": [
              274.95703125,
              577.16015625,
              501.7265625,
              590.296875
            ]
          }
        ],
