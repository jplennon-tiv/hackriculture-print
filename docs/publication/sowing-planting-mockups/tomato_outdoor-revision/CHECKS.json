    "imperial": {
      "source": "docs/publication/sowing-planting-mockups/conventional/tomato_outdoor-imperial.html",
      "pdf": "output/pdf/sowing-planting-mockups/tomato_outdoor-revision/tomato_outdoor-imperial.pdf",
      "care": "Tie cordons about every 12 in.. Pinch out side shoots when 1 in. long. Remove yellow leaves sparingly. Bushes usually need no pruning. Support heavy stems.",
      "methods": [
        {
          "title": "Sow indoors",
          "text": "Fill pots or a seed tray with seed compost. Keep warm for germination. Give seedlings plenty of light."
        },
        {
          "title": "Prick out and pot on",
          "text": "At the first true leaves, lift tray seedlings into individual pots. Hold a leaf and support the roots. Pot on when the roots fill the pot."
        },
        {
          "title": "Harden off",
          "text": "Introduce plants to outdoor conditions over about two weeks. Protect from frost."
        },
        {
          "title": "Plant out",
          "text": "Wait for warm weather after frost risk has passed. Plants should be well rooted, with the first flowers opening. Water first, keep the rootball intact and plant slightly deeper than in the pot."
        }
      ],
